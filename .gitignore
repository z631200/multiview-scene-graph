# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.conda-env/
.conda/
.env
.env.*
!.env.example

# Generated scenes and experiments; samples are intentionally versioned.
/data/scenes/*
!/data/scenes/sample/
/data/runs/*
!/data/runs/sample/

# Old commands must not accidentally add regenerated legacy output.
/outputs/
/colab/scene_output/
*.egg-info/
